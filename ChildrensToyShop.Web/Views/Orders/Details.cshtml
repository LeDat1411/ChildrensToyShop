@model Order
@{ ViewData["Title"] = Model.OrderNumber; }

<div class="section-heading">
    <div><p class="eyebrow">Order @Model.OrderNumber</p><h1>Order details</h1></div>
    <span class="status large">@Model.Status</span>
</div>
<div class="checkout-layout">
    <div>
        <section class="form-card">
            <h2>Items</h2>
            @foreach (var item in Model.Items)
            {
                <div class="order-line">
                    <span><strong>@item.ProductTitle</strong><br /><small>@item.Sku · Qty @item.Quantity @(item.GiftWrap ? "· Gift wrap" : "")</small></span>
                    <span>$@((item.UnitPrice * item.Quantity).ToString("0.00"))</span>
                </div>
            }
            <hr />
            <p><strong>Shipping to:</strong><br />@Model.ShippingAddress</p>
            @if (!string.IsNullOrEmpty(Model.TrackingNumber))
            {
                <p><strong>Tracking:</strong> @Model.TrackingNumber</p>
            }
            <dl>
                <dt>Subtotal</dt><dd>$@Model.Subtotal.ToString("0.00")</dd>
                <dt>Gift wrap</dt><dd>$@Model.GiftWrapFee.ToString("0.00")</dd>
                <dt>Tax</dt><dd>$@Model.Tax.ToString("0.00")</dd>
                @if (Model.CouponCode is not null)
                {
                    <dt>Coupon @Model.CouponCode</dt><dd>−$@Model.DiscountAmount.ToString("0.00")</dd>
                }
                <dt class="total">@(Model.Status == OrderStatus.Cancelled ? "Original total" : "Paid total")</dt>
                <dd class="total">$@Model.Total.ToString("0.00")</dd>
            </dl>
        </section>
        @if (Model.Status is OrderStatus.Paid or OrderStatus.Processing)
        {
            <form asp-action="Cancel" method="post" class="mt-3">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-outline-danger">Cancel order</button>
            </form>
        }
    </div>
    @if (User.IsInRole("Admin") && Model.Status != OrderStatus.Cancelled)
    {
        <aside class="summary-card">
            <h2>Fulfillment</h2>
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <label for="status" class="form-label">Status</label>
                <select id="status" name="status" class="form-select">
                    @foreach (var status in new[] { OrderStatus.Paid, OrderStatus.Processing, OrderStatus.Shipped, OrderStatus.Delivered })
                    {
                        <option value="@status" selected="@(status == Model.Status)">@status</option>
                    }
                </select>
                <label for="trackingNumber" class="form-label mt-3">Tracking number</label>
                <input id="trackingNumber" name="trackingNumber" value="@Model.TrackingNumber" class="form-control" />
                <button class="btn btn-primary mt-3 w-100">Update fulfillment</button>
            </form>
        </aside>
    }
</div>
