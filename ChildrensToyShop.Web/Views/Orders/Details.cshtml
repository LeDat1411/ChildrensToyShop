@model Order
@{ ViewData["Title"] = Model.OrderNumber; }
<div class="section-heading"><div><p class="eyebrow">Order @Model.OrderNumber</p><h1>Order details</h1></div><span class="status large">@Model.Status</span></div>
<div class="checkout-layout"><div><section class="form-card"><h2>Items</h2>@foreach(var item in Model.Items){<div class="order-line"><span><strong>@item.ProductTitle</strong><br /><small>@item.Sku · Qty @item.Quantity @(item.GiftWrap ? "· Gift wrap" : "")</small></span><span>$@((item.UnitPrice * item.Quantity).ToString("0.00"))</span></div>}<hr /><p><strong>Shipping to:</strong><br />@Model.ShippingAddress</p>@if(!string.IsNullOrEmpty(Model.TrackingNumber)){<p><strong>Tracking:</strong> @Model.TrackingNumber</p>}<dl><dt>Subtotal</dt><dd>$@Model.Subtotal.ToString("0.00")</dd><dt>Tax and gift wrap</dt><dd>$@((Model.Tax+Model.GiftWrapFee).ToString("0.00"))</dd><dt class="total">Paid total</dt><dd class="total">$@Model.Total.ToString("0.00")</dd></dl></section>@if(Model.Status is not OrderStatus.Shipped and not OrderStatus.Delivered and not OrderStatus.Cancelled){<form asp-action="Cancel" method="post" class="mt-3"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-outline-danger">Cancel order and restore stock</button></form>}</div>@if(User.IsInRole("Admin")){<aside class="summary-card"><h2>Fulfillment</h2><form asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@Model.Id"/><label class="form-label">Status</label><select name="status" class="form-select"><option>PAID</option><option>PROCESSING</option><option>SHIPPED</option><option>DELIVERED</option></select><label class="form-label mt-3">Tracking number</label><input name="trackingNumber" value="@Model.TrackingNumber" class="form-control"/><button class="btn btn-primary mt-3 w-100">Update fulfillment</button></form></aside>}</div>
