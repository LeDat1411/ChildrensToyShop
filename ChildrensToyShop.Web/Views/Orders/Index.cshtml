@model IEnumerable<Order>
@{ ViewData["Title"] = User.IsInRole("Admin") ? "Fulfillment orders" : "My orders"; }
<div class="section-heading"><div><p class="eyebrow">@(User.IsInRole("Admin") ? "Store management" : "Your purchases")</p><h1>@ViewData["Title"]</h1></div></div>
@if(!Model.Any()){<div class="empty-state"><h2>No orders yet.</h2><a class="btn btn-primary" asp-controller="Products" asp-action="Index">Shop toys</a></div>}else{<div class="table-responsive"><table class="table order-table"><thead><tr><th>Order</th>@if(User.IsInRole("Admin")){<th>Customer</th>}<th>Date</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var order in Model){<tr><td>@order.OrderNumber</td>@if(User.IsInRole("Admin")){<td>@order.User?.DisplayName</td>}<td>@order.CreatedAt.ToLocalTime().ToString("d")</td><td><span class="status">@order.Status</span></td><td>$@order.Total.ToString("0.00")</td><td><a asp-action="Details" asp-route-id="@order.Id">View</a></td></tr>}</tbody></table></div>}
