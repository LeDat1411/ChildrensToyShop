@model CheckoutViewModel
@{ ViewData["Title"] = "Checkout"; }
<div class="checkout-layout"><div class="form-card"><p class="eyebrow">Final step</p><h1>Checkout</h1><p>Transactions are simulated for this project. Clicking place order automatically accepts the payment.</p><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="ShippingAddress" class="form-label"></label><textarea asp-for="ShippingAddress" class="form-control" rows="4" placeholder="Name, street, city, postal code"></textarea><span asp-validation-for="ShippingAddress" class="text-danger"></span><button class="btn btn-primary mt-4">Place simulated order</button><a class="btn btn-link mt-4" asp-controller="Cart" asp-action="Index">Back to cart</a></form></div><aside class="summary-card"><h2>Order total</h2><p>@Model.Cart.Cart.Items.Sum(x => x.Quantity) item(s)</p><dl><dt>Subtotal</dt><dd>$@Model.Cart.Subtotal.ToString("0.00")</dd><dt>Tax</dt><dd>$@Model.Cart.Tax.ToString("0.00")</dd><dt class="total">Total</dt><dd class="total">$@Model.Cart.Total.ToString("0.00")</dd></dl></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
