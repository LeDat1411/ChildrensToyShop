@model CheckoutViewModel
@{ ViewData["Title"] = "Checkout"; }

<div class="checkout-layout">
    <div class="form-card">
        <h1>Checkout</h1>
        <p>Placing your order automatically accepts the simulated payment.</p>
        <form method="post">
            <input type="hidden" name="ExpectedCouponCode" value="@Model.Cart.Cart.CouponCode" />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <label asp-for="ShippingAddress" class="form-label"></label>
            <textarea asp-for="ShippingAddress" class="form-control" rows="4" placeholder="Name, street, city, postal code"></textarea>
            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
            <button class="btn btn-primary mt-4">Place simulated order</button>
            <a class="btn btn-link mt-4" asp-controller="Cart" asp-action="Index">Back to cart</a>
        </form>
    </div>
    <aside class="summary-card">
        <h2>Order total</h2>
        <p>@Model.Cart.Cart.Items.Sum(x => x.Quantity) item(s)</p>
        <partial name="_CartTotals" model="Model.Cart" />
    </aside>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
