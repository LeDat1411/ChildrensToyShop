@model Review
<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label asp-for="Rating" class="form-label"></label><select asp-for="Rating" class="form-select"><option value="1">1 star</option><option value="2">2 stars</option><option value="3">3 stars</option><option value="4">4 stars</option><option value="5">5 stars</option></select></div><div class="col-md-8"><label asp-for="ActualAgeSuitability" class="form-label"></label><input asp-for="ActualAgeSuitability" class="form-control" /></div><div class="col-12"><label asp-for="Comment" class="form-label"></label><textarea asp-for="Comment" class="form-control" rows="5"></textarea></div></div>
