@model Review
@{ ViewData["Title"] = "Edit review"; }
<div class="form-card"><p class="eyebrow">@ViewBag.ProductTitle</p><h1>Edit review</h1><form method="post"><input asp-for="Id" type="hidden"/><input asp-for="ProductId" type="hidden"/><partial name="_ReviewForm" model="Model"/>@if(User.IsInRole("Admin")){<label class="form-label mt-3">Moderation status</label><select asp-for="VisibilityStatus" class="form-select"><option>PENDING</option><option>APPROVED</option><option>FLAGGED</option></select>}<button class="btn btn-primary mt-4">Save review</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
