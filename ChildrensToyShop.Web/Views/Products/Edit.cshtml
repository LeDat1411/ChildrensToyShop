@model Product
@{ ViewData["Title"] = Model.Id == 0 ? "Add toy" : "Edit toy"; var isNew = Model.Id == 0; }
<div class="form-card"><p class="eyebrow">Inventory management</p><h1>@ViewData["Title"]</h1><form method="post" asp-action="@(isNew ? "Create" : "Edit")"><input asp-for="Id" type="hidden" /><input asp-for="CreatedAt" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-4"><label asp-for="Sku" class="form-label"></label><input asp-for="Sku" class="form-control" /></div><div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="col-md-3"><label asp-for="Price" class="form-label"></label><input asp-for="Price" class="form-control" /></div><div class="col-md-3"><label asp-for="StockQuantity" class="form-label"></label><input asp-for="StockQuantity" class="form-control" /></div><div class="col-md-3"><label asp-for="ReorderThreshold" class="form-label"></label><input asp-for="ReorderThreshold" class="form-control" /></div><div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Active</option><option>Recalled</option><option>Discontinued</option></select></div><div class="col-md-4"><label asp-for="AgeRange" class="form-label"></label><input asp-for="AgeRange" class="form-control" /></div><div class="col-md-4"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" /></div><div class="col-md-4"><label asp-for="Brand" class="form-label"></label><input asp-for="Brand" class="form-control" /></div><div class="col-md-6"><label asp-for="SafetyCertification" class="form-label"></label><input asp-for="SafetyCertification" class="form-control" /></div><div class="col-md-6"><label asp-for="SafetyNotes" class="form-label"></label><input asp-for="SafetyNotes" class="form-control" /></div><div class="col-12"><label class="form-check"><input asp-for="IsActive" class="form-check-input" /> Active listing</label></div></div><div class="mt-4"><button class="btn btn-primary">Save toy</button><a class="btn btn-link" asp-action="Index">Cancel</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
