@model ProductListViewModel
@{ ViewData["Title"] = "Toy collection"; }
<div class="section-heading"><div><p class="eyebrow">Browse the catalogue</p><h1>Toys for every bright idea</h1></div>@if (User.IsInRole("Admin")) { <a class="btn btn-primary" asp-action="Create">Add a toy</a> }</div>
<form class="filter-bar" method="get"><input name="search" value="@Model.Search" placeholder="Search toys or SKU" class="form-control" /><select name="category" class="form-select"><option value="">All categories</option>@foreach(var x in Model.Categories){<option selected="@(x == Model.Category)" value="@x">@x</option>}</select><select name="ageRange" class="form-select"><option value="">All ages</option>@foreach(var x in Model.AgeRanges){<option selected="@(x == Model.AgeRange)" value="@x">@x</option>}</select><select name="brand" class="form-select"><option value="">All brands</option>@foreach(var x in Model.Brands){<option selected="@(x == Model.Brand)" value="@x">@x</option>}</select><label class="form-check-label"><input type="checkbox" name="inStock" value="true" checked="@Model.InStock" class="form-check-input" /> In stock</label><button class="btn btn-primary">Filter</button></form>
<div class="row g-4 mt-1">@foreach (var product in Model.Products) { <div class="col-md-6 col-lg-4"><partial name="_ProductCard" model="product" />@if (User.IsInRole("Admin")) { <div class="mt-2"><a class="btn btn-sm btn-link" asp-action="Edit" asp-route-id="@product.Id">Edit</a><form class="d-inline" method="post" asp-action="Delete" asp-route-id="@product.Id"><button class="btn btn-sm btn-link text-danger" onclick="return confirm('Archive this toy?')">Archive</button></form></div> }</div> }</div>
@if (!Model.Products.Any()) { <div class="empty-state"><h2>No toys matched those filters.</h2><a asp-action="Index">Clear filters</a></div> }
