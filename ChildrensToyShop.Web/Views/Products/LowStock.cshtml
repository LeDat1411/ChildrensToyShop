@model IReadOnlyList<Product>
@{ ViewData["Title"] = "Low Stock Alerts"; }

<div class="section-heading">
    <h1>Low Stock Alerts</h1>
    <a class="btn btn-outline-primary" asp-action="Index">View catalogue</a>
</div>
<p>Listed toys appear here when their stock quantity is at or below their reorder threshold.</p>

@if (Model.Count == 0)
{
    <div class="empty-state"><h2>No toys are at or below their reorder threshold.</h2></div>
}
else
{
    <div class="table-responsive">
        <table class="table order-table align-middle">
            <thead><tr><th scope="col">Toy</th><th scope="col">SKU</th><th scope="col">Stock</th><th scope="col">Threshold</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <th scope="row">@product.Title</th>
                        <td>@product.Sku</td>
                        <td>@product.StockQuantity</td>
                        <td>@product.ReorderThreshold</td>
                        <td>
                            @if (product.Status == ProductStatus.Recalled)
                            {
                                <span class="badge text-bg-danger">Recalled · do not reorder</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">@(product.StockQuantity == 0 ? "Out of stock" : "Low stock")</span>
                            }
                        </td>
                        <td><a asp-action="Edit" asp-route-id="@product.Id" aria-label="Edit @product.Title">Edit toy</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
