@model Product
@{ ViewData["Title"] = Model.Title; var reviews = Model.Reviews.Where(x => x.VisibilityStatus == ReviewStatus.Approved).OrderByDescending(x => x.UpdatedAt); }
<div class="details-grid"><div class="product-hero-mark">@Model.Category.Substring(0,1)</div><div><p class="eyebrow">@Model.Brand · @Model.Sku</p><h1>@Model.Title</h1><p class="lead">@Model.Description</p><h2 class="price">$@Model.Price.ToString("0.00")</h2><p><span class="badge text-bg-light">Ages @Model.AgeRange</span> <span class="badge @(Model.StockQuantity > 0 && Model.Status == ProductStatus.Active ? "text-bg-success" : "text-bg-danger")">@(Model.StockQuantity > 0 && Model.Status == ProductStatus.Active ? $"{Model.StockQuantity} in stock" : Model.Status)</span></p><p><strong>Safety:</strong> @Model.SafetyCertification. @Model.SafetyNotes</p>@if (Model.StockQuantity > 0 && Model.Status == ProductStatus.Active) { <form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path" /><button class="btn btn-primary">Add to cart</button></form> } else { <div class="alert alert-danger">SALE PROHIBITED: This toy cannot be sold.</div> }</div></div>
<section class="mt-5"><div class="section-heading"><div><p class="eyebrow">Parent feedback</p><h2>Reviews and real-world fit</h2></div>@if(User.Identity?.IsAuthenticated == true){<a class="btn btn-outline-primary" asp-controller="Reviews" asp-action="Create" asp-route-productId="@Model.Id">Write a review</a>}</div>@if(reviews.Any()){foreach(var review in reviews){<article class="review"><strong>@review.Rating / 5 stars</strong><span class="text-muted"> · Suitable for @review.ActualAgeSuitability</span><p>@review.Comment</p><small>@review.User?.DisplayName</small></article>}}else{<p class="text-muted">No approved reviews yet.</p>}</section>
